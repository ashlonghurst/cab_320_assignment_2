    "def create_accelerated_model(lr, momentum):\n",
    "    model = tf.keras.Sequential([\n",
    "        tf.keras.layers.Input(shape=(1280,)),\n",
    "        tf.keras.layers.Dense(5, activation='softmax')\n",
    "    ])\n",
    "\n",
